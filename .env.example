# ── Base de datos (Railway la inyecta automática si agregás el plugin Postgres) ──
DATABASE_URL="postgresql://user:password@localhost:5432/trainy"

# ── NextAuth ──
# Generar con: openssl rand -base64 32
AUTH_SECRET="cambiame"
# URL pública de la app (en Railway: https://<tu-app>.up.railway.app)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Google OAuth (OPCIONAL — si no se configura, la app usa email+password) ──
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── API key para importar planes desde el skill Trainy (POST /api/import) ──
# Generar con: openssl rand -hex 24
TRAINY_API_KEY="cambiame"

# ── Coach IA + generador de planes (OPCIONAL — sin esto no aparecen) ──
# Key de https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=""
# Modelo del coach (default: claude-sonnet-5)
COACH_MODEL=""

# ── Correo: recuperación de cuenta + recordatorios (MUY recomendado) ──
# Key de https://resend.com → API Keys. Free tier: 3.000 emails/mes.
# Con dominio propio verificado en Resend, poné EMAIL_FROM="Trainy <no-reply@tudominio.com>"
#
# Sin esta variable:
#   · el login por código queda oculto y quien olvide su contraseña depende de
#     que el coach le genere una temporal desde su panel;
#   · POST /api/reminders responde 503 y no manda nada (GET sigue sirviendo para
#     ver el simulacro de a quién se le escribiría).
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Recordatorios de sesión ──
# Se disparan con un cron que pegue una vez al día contra la app:
#   curl -X POST https://<tu-app>/api/reminders -H "x-api-key: $TRAINY_API_KEY"
# Simulacro sin mandar nada (útil para revisarlo antes de encenderlo):
#   curl https://<tu-app>/api/reminders -H "x-api-key: $TRAINY_API_KEY"
# Usa TRAINY_API_KEY, no hace falta otra variable.
